<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>QuickCash - Verify Phone</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
        }
        .page-container {
            max-width: 420px;
            margin: 0 auto;
            min-height: 100vh;
            background: white;
            position: relative;
        }
        .top-bar {
            background: linear-gradient(135deg, #1a237e, #283593);
            padding: 60px 25px 40px;
            border-radius: 0 0 30px 30px;
            text-align: center;
            position: relative;
        }
        .back-btn {
            position: absolute;
            top: 50px;
            left: 20px;
            background: rgba(255,255,255,0.15);
            border: none;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
            backdrop-filter: blur(10px);
        }
        .step-indicator {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 25px;
        }
        .dot { width: 8px; height: 8px; border-radius: 4px; background: rgba(255,255,255,0.3); }
        .dot.active { background: #ffd700; width: 28px; }
        .page-title { color: white; font-size: 22px; font-weight: 700; }
        .page-subtitle { color: rgba(255,255,255,0.7); font-size: 14px; margin-top: 5px; }
        
        .form-section {
            padding: 30px 25px;
        }
        .input-label { font-size: 13px; font-weight: 600; color: #333; margin-bottom: 8px; display: block; }
        .phone-input-group { display: flex; gap: 10px; align-items: center; }
        .country-code {
            background: #f5f5f5;
            padding: 16px 12px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 16px;
            color: #333;
            border: 2px solid #e0e0e0;
        }
        .phone-input-group input {
            flex: 1;
            padding: 16px;
            border: 2px solid #e0e0e0;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 2px;
            transition: border 0.3s;
        }
        .phone-input-group input:focus { border-color: #1a237e; outline: none; }
        
        .send-otp-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #1a237e, #3949ab);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }
        .send-otp-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(26,35,126,0.3); }
        .send-otp-btn:disabled { background: #ccc; transform: none; box-shadow: none; }
        
        /* OTP Section */
        .otp-section { display: none; margin-top: 30px; padding-top: 30px; border-top: 1px solid #eee; }
        .otp-section.show { display: block; animation: slideDown 0.4s ease; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        
        .otp-inputs {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 20px 0;
        }
        .otp-inputs input {
            width: 50px;
            height: 56px;
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            transition: border 0.3s;
        }
        .otp-inputs input:focus { border-color: #1a237e; outline: none; }
        .otp-timer { text-align: center; color: #666; font-size: 14px; margin: 10px 0; }
        .otp-timer span { color: #1a237e; font-weight: 600; }
        .resend-btn {
            background: none;
            border: none;
            color: #1a237e;
            font-weight: 600;
            cursor: pointer;
            text-decoration: underline;
        }
        .resend-btn:disabled { color: #ccc; cursor: not-allowed; text-decoration: none; }
        
        .verify-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #ffd700, #ffab00);
            color: #1a237e;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }
        .verify-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,215,0,0.3); }
        
        .info-text {
            text-align: center;
            color: #999;
            font-size: 12px;
            margin-top: 15px;
        }
    </style>
</head>
<body>
    <div class="page-container">
        <div class="top-bar">
            <button class="back-btn" onclick="history.back()">←</button>
            <div class="step-indicator">
                <div class="dot active"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            </div>
            <h1 class="page-title">Verify Your Phone</h1>
            <p class="page-subtitle">We'll send an OTP to verify your number</p>
        </div>
        
        <div class="form-section">
            <!-- Phone Input -->
            <label class="input-label">Mobile Number</label>
            <div class="phone-input-group">
                <span class="country-code">🇮🇳 +91</span>
                <input type="tel" id="phone" maxlength="10" placeholder="9876543210" pattern="[0-9]{10}" autofocus>
            </div>
            
            <button class="send-otp-btn" id="sendOtpBtn" onclick="sendOTP()">Send OTP</button>
            
            <!-- OTP Section -->
            <div class="otp-section" id="otpSection">
                <label class="input-label" style="text-align:center;">Enter OTP sent to <span id="phoneDisplay">+91 XXXXXXXX10</span></label>
                <div class="otp-inputs">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 1)" id="otp0">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 2)" id="otp1">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 3)" id="otp2">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 4)" id="otp3">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 5)" id="otp4">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" oninput="moveNext(this, 6)" id="otp5">
                </div>
                
                <div class="otp-timer">
                    Resend OTP in <span id="timer">00:30</span>
                </div>
                <button class="resend-btn" id="resendBtn" disabled onclick="resendOTP()">Resend OTP</button>
                
                <form action="/page3" method="GET">
                    <input type="hidden" name="phone" id="hiddenPhone">
                    <button type="submit" class="verify-btn">✅ Verify & Continue</button>
                </form>
                
                <p class="info-text">OTP is for verification only</p>
            </div>
        </div>
    </div>

    <script>
        let timerInterval;
        let timeLeft = 30;
        let otpSent = false;
        
        function sendOTP() {
            const phone = document.getElementById('phone').value;
            if (phone.length !== 10 || !/^[0-9]{10}$/.test(phone)) {
                alert('Please enter a valid 10-digit mobile number');
                return;
            }
            
            // Show OTP section
            document.getElementById('otpSection').classList.add('show');
            document.getElementById('sendOtpBtn').disabled = true;
            document.getElementById('sendOtpBtn').textContent = '✅ OTP Sent!';
            
            // Show masked phone
            document.getElementById('phoneDisplay').textContent = `+91 ${phone.slice(0,2)}XXXXX${phone.slice(7)}`;
            document.getElementById('hiddenPhone').value = phone;
            
            // Start timer
            timeLeft = 30;
            startTimer();
            
            // Auto-focus first OTP input
            setTimeout(() => document.getElementById('otp0').focus(), 300);
        }
        
        function startTimer() {
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timeLeft--;
                const mins = Math.floor(timeLeft / 60);
                const secs = timeLeft % 60;
                document.getElementById('timer').textContent = 
                    `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('resendBtn').disabled = false;
                    document.getElementById('timer').textContent = '00:00';
                }
            }, 1000);
        }
        
        function resendOTP() {
            document.getElementById('resendBtn').disabled = true;
            timeLeft = 30;
            startTimer();
        }
        
        function moveNext(current, nextId) {
            if (current.value.length >= 1 && nextId <= 5) {
                document.getElementById(`otp${nextId}`).focus();
            }
        }
    </script>
</body>
</html>
